<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="M8.Color.Background">#F4F3F0</Color>
  <SolidColorBrush x:Key="M8.Background" Color="{DynamicResource M8.Color.Background}"/>
  <Color x:Key="M8.Color.Glass">#8CFFFFFF</Color>
  <SolidColorBrush x:Key="M8.Glass" Color="{DynamicResource M8.Color.Glass}"/>
  <Color x:Key="M8.Color.GlassEdge">#CCFFFFFF</Color>
  <SolidColorBrush x:Key="M8.GlassEdge" Color="{DynamicResource M8.Color.GlassEdge}"/>
  <Color x:Key="M8.Color.Text">#1C1C1E</Color>
  <SolidColorBrush x:Key="M8.Text" Color="{DynamicResource M8.Color.Text}"/>
  <Color x:Key="M8.Color.Muted">#8E8E93</Color>
  <SolidColorBrush x:Key="M8.Muted" Color="{DynamicResource M8.Color.Muted}"/>
  <Color x:Key="M8.Color.Secondary">#636369</Color>
  <SolidColorBrush x:Key="M8.Secondary" Color="{DynamicResource M8.Color.Secondary}"/>
  <Color x:Key="M8.Color.Primary">#1C1C1E</Color>
  <SolidColorBrush x:Key="M8.Primary" Color="{DynamicResource M8.Color.Primary}"/>
  <Color x:Key="M8.Color.OnPrimary">#FFFFFF</Color>
  <SolidColorBrush x:Key="M8.OnPrimary" Color="{DynamicResource M8.Color.OnPrimary}"/>
  <Color x:Key="M8.Color.Subtle">#0C1C1C1E</Color>
  <SolidColorBrush x:Key="M8.Subtle" Color="{DynamicResource M8.Color.Subtle}"/>
  <Color x:Key="M8.Color.Hover">#141C1C1E</Color>
  <SolidColorBrush x:Key="M8.Hover" Color="{DynamicResource M8.Color.Hover}"/>
  <Color x:Key="M8.Color.Line">#181C1C1E</Color>
  <SolidColorBrush x:Key="M8.Line" Color="{DynamicResource M8.Color.Line}"/>
  <Color x:Key="M8.Color.Popup">#F8F8F6</Color>
  <SolidColorBrush x:Key="M8.Popup" Color="{DynamicResource M8.Color.Popup}"/>
  <Color x:Key="M8.Color.Transparent">Transparent</Color>
  <SolidColorBrush x:Key="M8.Transparent" Color="{DynamicResource M8.Color.Transparent}"/>
  <Color x:Key="M8.Color.HoverLight">#0AFFFFFF</Color>
  <SolidColorBrush x:Key="M8.HoverLight" Color="{DynamicResource M8.Color.HoverLight}"/>
  <Color x:Key="M8.Color.FocusDot">#A8E6CF</Color>
  <SolidColorBrush x:Key="M8.FocusDot" Color="{DynamicResource M8.Color.FocusDot}"/>
  <Color x:Key="M8.Color.WarnDot">#FFD6A5</Color>
  <SolidColorBrush x:Key="M8.WarnDot" Color="{DynamicResource M8.Color.WarnDot}"/>
  <Color x:Key="M8.Color.BlockDot">#FF8FA3</Color>
  <SolidColorBrush x:Key="M8.BlockDot" Color="{DynamicResource M8.Color.BlockDot}"/>
  <Color x:Key="M8.Color.IdleDot">#D9D3F5</Color>
  <SolidColorBrush x:Key="M8.IdleDot" Color="{DynamicResource M8.Color.IdleDot}"/>
  <Color x:Key="M8.Focus.A">#A8E6CF</Color><Color x:Key="M8.Focus.B">#B8D8F8</Color>
  <Color x:Key="M8.Warn.A">#FFD6A5</Color><Color x:Key="M8.Warn.B">#FFB5A7</Color>
  <Color x:Key="M8.Block.A">#FF8FA3</Color><Color x:Key="M8.Block.B">#C9B6F2</Color>
  <Color x:Key="M8.Idle.A">#D9D3F5</Color><Color x:Key="M8.Idle.B">#E5E5EA</Color>
  <sys:Double x:Key="M8.Glow.Opacity">0.72</sys:Double>
  <DropShadowEffect x:Key="M8.CardShadow" Color="#1A1A2E" Opacity="0.06" BlurRadius="40" ShadowDepth="12" Direction="270"/>
  <SolidColorBrush x:Key="M8.WindowTint" Color="#B3F4F3F0"/>
</ResourceDictionary>
