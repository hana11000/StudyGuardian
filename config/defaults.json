    "recentActivityLimit": 5,
    "browserProcesses": ["chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "vivaldi.exe", "arc.exe"],
    "mixedContentDomains": ["bilibili.com", "zhihu.com", "weixin.qq.com", "wechat.com", "youtube.com", "youtu.be", "reddit.com", "douyin.com", "weibo.com", "x.com", "twitter.com", "baidu.com", "bing.com", "google.com"]
