<UserControl x:Class="StudyGuardian.App.Controls.WindowHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{DynamicResource M8.Transparent}" MouseLeftButtonDown="DragHeader" Margin="24,8,12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
      <TextBlock Text="◌" FontSize="{DynamicResource M8.Type.Title}" Margin="0,0,10,0"/>
      <TextBlock Text="{Binding Title,RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="◐" Click="ThemeClick" Style="{DynamicResource M8.TextButton}" ToolTip="浅色 / 深色" AutomationProperties.Name="切换主题"/>
      <Button Content="−" Click="MinimizeClick" Style="{DynamicResource M8.TextButton}" ToolTip="最小化" AutomationProperties.Name="最小化"/>
      <Button Content="×" Click="CloseClick" Style="{DynamicResource M8.TextButton}" ToolTip="关闭" AutomationProperties.Name="关闭窗口"/>
    </StackPanel>
  </Grid>
</UserControl>
