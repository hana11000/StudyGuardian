<Window x:Class="StudyGuardian.App.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Guardian · 悬浮窗" Width="400" Height="106" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Style="{StaticResource {x:Type Window}}" Closing="OnClosing">
  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,15" MouseLeftButtonDown="DragWindow">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource AmberBrush}" />
        <TextBlock x:Name="StatusText" Text="待判定" FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock x:Name="TimeText" Grid.Column="1" FontFamily="Consolas" FontSize="25" Text="50:00" />
      <Grid Grid.Row="1" Margin="0,12,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="GoalText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock x:Name="FocusText" Grid.Column="1" Text="专注率 —" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
      </Grid>
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
        <Button x:Name="PauseButton" Content="Ⅱ" Padding="7,4" Background="Transparent" BorderThickness="0" Click="PauseClick" ToolTip="暂停" AutomationProperties.Name="暂停" />
        <Button x:Name="BreakButton" Content="☕" Padding="7,4" Background="Transparent" BorderThickness="0" Click="BreakClick" ToolTip="休息" AutomationProperties.Name="休息" />
        <Button Content="↗" Padding="7,4" Background="Transparent" BorderThickness="0" Click="OpenMainClick" ToolTip="打开主窗口" AutomationProperties.Name="打开主窗口" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
