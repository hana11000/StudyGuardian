<Window x:Class="StudyGuardian.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
  <StackPanel Margin="24">
    <DockPanel Margin="0,0,0,24">
      <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" Content="启用 AI" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
      <TextBlock Text="API 设置" FontSize="21" FontWeight="SemiBold" />
    </DockPanel>
    <DockPanel Margin="0,0,0,8">
      <TextBlock x:Name="KeyStatus" DockPanel.Dock="Right" Style="{StaticResource MutedText}" />
      <TextBlock Text="API Key" />
    </DockPanel>
    <PasswordBox x:Name="KeyBox" Height="42" Padding="10" Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="API Key" />
    <Button x:Name="ClearKeyButton" Content="清除密钥" Click="ClearKeyClick" HorizontalAlignment="Right" Background="Transparent" Padding="8" Margin="0,4,0,14" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
    <TextBlock Text="模型" Margin="0,0,0,8" />
    <TextBox x:Name="ModelBox" AutomationProperties.Name="模型" />
    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" />
    <DockPanel Margin="0,0,0,12">
      <TextBlock x:Name="BrowserPortText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" />
      <TextBlock Text="浏览器扩展" FontSize="17" FontWeight="SemiBold" />
    </DockPanel>
    <DockPanel>
      <Button Content="重置" DockPanel.Dock="Right" Click="ResetPairingClick" Padding="14,8" Margin="8,0,0,0" />
      <Button Content="复制配对码" Click="CopyPairingClick" Padding="14,8" />
    </DockPanel>
    <TextBlock x:Name="PairingStatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
    <Button Content="保存" Click="SaveClick" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" />
  </StackPanel>
</Window>
