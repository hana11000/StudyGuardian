<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:StudyGuardian.App.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/StudyGuardian.App;component/Themes/Tokens.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="M8.Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource M8.Type.Title}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
  </Style>
  <Style x:Key="M8.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource M8.Type.Caption}"/>
    <Setter Property="Foreground" Value="{DynamicResource M8.Muted}"/>
  </Style>
  <Style x:Key="M8.Timer" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource M8.Font.Number}"/>
    <Setter Property="FontSize" Value="{StaticResource M8.Type.Timer}"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
  </Style>
  <Style x:Key="M8.GlassCard" TargetType="ContentControl">
    <Setter Property="Padding" Value="{StaticResource M8.Space.Card}"/>
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
      <Grid>
        <Border Background="{DynamicResource M8.Glass}" CornerRadius="{StaticResource M8.Radius.Card}" Effect="{DynamicResource M8.CardShadow}"/>
        <Border Background="{StaticResource M8.Noise}" Opacity="{StaticResource M8.Noise.Opacity}" CornerRadius="{StaticResource M8.Radius.Card}" IsHitTestVisible="False"/>
        <Border CornerRadius="{StaticResource M8.Radius.Card}" BorderBrush="{DynamicResource M8.GlassEdge}" BorderThickness="{StaticResource M8.Border.Thin}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.Button" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
    <Setter Property="Background" Value="{DynamicResource M8.Subtle}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource M8.Transparent}"/>
    <Setter Property="FontSize" Value="{StaticResource M8.Type.Body}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="{StaticResource M8.Space.Button}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid x:Name="Shell" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
        <ui:PillBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource M8.Border.Thin}"/>
        <ui:PillBorder x:Name="Hover" Background="{DynamicResource M8.HoverLight}" Opacity="0" IsHitTestVisible="False"/>
        <ui:PillBorder x:Name="Focus" BorderBrush="{DynamicResource M8.Text}" BorderThickness="{StaticResource M8.Border.Thin}" Opacity="0" Margin="-3" IsHitTestVisible="False"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.8"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="{StaticResource M8.Disabled.Opacity}"/></Trigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="{StaticResource M8.Motion.HoverScale}" Duration="{StaticResource M8.Motion.Hover}" EasingFunction="{StaticResource M8.Ease.Soft}"/>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="{StaticResource M8.Motion.HoverScale}" Duration="{StaticResource M8.Motion.Hover}" EasingFunction="{StaticResource M8.Ease.Soft}"/>
          </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
          <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource M8.Motion.Hover}" EasingFunction="{StaticResource M8.Ease.Soft}"/>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource M8.Motion.Hover}" EasingFunction="{StaticResource M8.Ease.Soft}"/>
          </Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
        </MultiDataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.PrimaryButton" TargetType="Button" BasedOn="{StaticResource M8.Button}">
    <Setter Property="Background" Value="{DynamicResource M8.Primary}"/><Setter Property="Foreground" Value="{DynamicResource M8.OnPrimary}"/>
  </Style>
  <Style x:Key="M8.TextButton" TargetType="Button" BasedOn="{StaticResource M8.Button}">
    <Setter Property="Background" Value="{DynamicResource M8.Transparent}"/><Setter Property="Foreground" Value="{DynamicResource M8.Secondary}"/>
    <Setter Property="Padding" Value="{StaticResource M8.Space.SmallButton}"/>
  </Style>
  <Style x:Key="M8.PillChoice" TargetType="RadioButton">
    <Setter Property="Background" Value="{DynamicResource M8.Subtle}"/><Setter Property="Foreground" Value="{DynamicResource M8.Secondary}"/>
    <Setter Property="Padding" Value="{StaticResource M8.Space.SmallButton}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="{StaticResource M8.Type.Body}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid>
        <ui:PillBorder x:Name="Shell" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="{StaticResource M8.Border.Thin}" BorderBrush="{DynamicResource M8.Transparent}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </ui:PillBorder>
        <ui:PillBorder x:Name="FocusOutline" BorderBrush="{DynamicResource M8.Text}" BorderThickness="{StaticResource M8.Border.Thin}" Margin="-3" Opacity="0" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource M8.Primary}"/><Setter Property="Foreground" Value="{DynamicResource M8.OnPrimary}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource M8.Line}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="{StaticResource M8.Disabled.Opacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.Tag" TargetType="ContentControl">
    <Setter Property="Foreground" Value="{DynamicResource M8.Secondary}"/><Setter Property="FontSize" Value="{StaticResource M8.Type.Caption}"/>
    <Setter Property="Padding" Value="{StaticResource M8.Space.SmallButton}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
      <ui:PillBorder Background="{DynamicResource M8.Subtle}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></ui:PillBorder>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.Input" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource M8.Subtle}"/><Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource M8.Text}"/><Setter Property="SelectionBrush" Value="{DynamicResource M8.Primary}"/><Setter Property="SelectionTextBrush" Value="{DynamicResource M8.OnPrimary}"/>
    <Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="FontSize" Value="{StaticResource M8.Type.Body}"/><Setter Property="Padding" Value="{StaticResource M8.Space.Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource M8.Transparent}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Shell" CornerRadius="{StaticResource M8.Radius.Input}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource M8.Border.Thin}">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource M8.Text}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="{StaticResource M8.Disabled.Opacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.GoalInput" TargetType="TextBox" BasedOn="{StaticResource M8.Input}">
    <Setter Property="FontSize" Value="{StaticResource M8.Type.Section}"/><Setter Property="Padding" Value="0,16"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Shell" Background="{DynamicResource M8.Transparent}" BorderBrush="{DynamicResource M8.Line}" BorderThickness="0,0,0,1">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource M8.Text}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.CheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource M8.Secondary}"/><Setter Property="FontSize" Value="{StaticResource M8.Type.Caption}"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <StackPanel x:Name="Shell" Orientation="Horizontal">
        <Border x:Name="Box" Width="18" Height="18" CornerRadius="6" BorderBrush="{DynamicResource M8.Secondary}" BorderThickness="{StaticResource M8.Border.Thin}" Background="{DynamicResource M8.Transparent}" Margin="0,0,8,0">
          <Path x:Name="Mark" Data="M 3,8 L 6.5,11.5 L 13,5" Stroke="{DynamicResource M8.OnPrimary}" StrokeThickness="1.5" Visibility="Collapsed"/>
        </Border>
        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource M8.Primary}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource M8.Primary}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="{StaticResource M8.Disabled.Opacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/><Setter Property="Padding" Value="{StaticResource M8.Space.SmallButton}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Shell" Background="{DynamicResource M8.Transparent}" CornerRadius="{StaticResource M8.Radius.Input}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource M8.Hover}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.ComboBox" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/><Setter Property="FontSize" Value="{StaticResource M8.Type.Body}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource M8.ComboBoxItem}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid x:Name="Shell">
        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Border Background="{DynamicResource M8.Subtle}" CornerRadius="{StaticResource M8.Radius.Input}" Padding="{StaticResource M8.Space.Input}">
              <TextBlock Text="⌄" Foreground="{DynamicResource M8.Secondary}" HorizontalAlignment="Right"/>
            </Border>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Border x:Name="Focus" BorderBrush="{DynamicResource M8.Text}" BorderThickness="{StaticResource M8.Border.Thin}" CornerRadius="{StaticResource M8.Radius.Input}" Visibility="Collapsed" IsHitTestVisible="False"/>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="16,12,40,12" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="{DynamicResource M8.Popup}" BorderBrush="{DynamicResource M8.Line}" BorderThickness="{StaticResource M8.Border.Thin}" CornerRadius="{StaticResource M8.Radius.Input}" Padding="8" Margin="0,8,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="{StaticResource M8.Disabled.Opacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
