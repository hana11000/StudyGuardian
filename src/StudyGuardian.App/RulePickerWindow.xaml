<Window x:Class="StudyGuardian.App.RulePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加规则" Width="600" Height="540" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <Button Content="刷新" DockPanel.Dock="Right" Click="RefreshClick" Padding="12,6"/>
      <TextBlock x:Name="Heading" Text="选择已打开的应用" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
      <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="搜索应用或窗口"/>
    </DockPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ChoicesPanel"/>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="手动输入" Click="ManualClick" Padding="12,9" Background="Transparent"/>
      <Button Content="取消" Grid.Column="2" IsCancel="True" Padding="18,9" Margin="0,0,8,0"/>
      <Button x:Name="AddButton" Content="添加" Grid.Column="3" Click="AddClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" Padding="18,9"/>
    </Grid>
  </Grid>
</Window>
