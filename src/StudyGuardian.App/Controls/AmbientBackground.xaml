<UserControl x:Class="StudyGuardian.App.Controls.AmbientBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
  <UserControl.Resources>
    <ResourceDictionary Source="/StudyGuardian.App;component/Themes/Tokens.xaml"/>
  </UserControl.Resources>
  <Grid Background="{DynamicResource M8.Background}" ClipToBounds="True">
    <Viewbox Stretch="UniformToFill">
      <Canvas x:Name="LightField" Width="1000" Height="800">
        <Ellipse x:Name="GlowA" Width="760" Height="640" Canvas.Left="-180" Canvas.Top="-100">
          <Ellipse.Effect><BlurEffect Radius="{StaticResource M8.Glow.Blur}" RenderingBias="Performance"/></Ellipse.Effect>
          <Ellipse.CacheMode><BitmapCache RenderAtScale="{StaticResource M8.Glow.CacheScale}"/></Ellipse.CacheMode>
          <Ellipse.RenderTransform><TranslateTransform x:Name="DriftA"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="GlowB" Width="700" Height="660" Canvas.Left="580" Canvas.Top="220">
          <Ellipse.Effect><BlurEffect Radius="{StaticResource M8.Glow.Blur}" RenderingBias="Performance"/></Ellipse.Effect>
          <Ellipse.CacheMode><BitmapCache RenderAtScale="{StaticResource M8.Glow.CacheScale}"/></Ellipse.CacheMode>
          <Ellipse.RenderTransform><TranslateTransform x:Name="DriftB"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="GlowC" Width="520" Height="460" Canvas.Left="350" Canvas.Top="-210" Opacity="0.45">
          <Ellipse.Effect><BlurEffect Radius="{StaticResource M8.Glow.Blur}" RenderingBias="Performance"/></Ellipse.Effect>
          <Ellipse.CacheMode><BitmapCache RenderAtScale="{StaticResource M8.Glow.CacheScale}"/></Ellipse.CacheMode>
          <Ellipse.RenderTransform><TranslateTransform x:Name="DriftC"/></Ellipse.RenderTransform>
        </Ellipse>
      </Canvas>
    </Viewbox>
  </Grid>
</UserControl>
