<UserControl x:Class="StudyGuardian.App.SessionSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StudyGuardian.App">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="这次要学什么？" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBox x:Name="GoalBox" Height="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="15" AutomationProperties.Name="学习目标" />
        <TextBlock x:Name="GoalError" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,6,0,0" />
        <TextBlock Text="时长（分钟）" Style="{StaticResource MutedText}" Margin="0,22,0,10" />
        <UniformGrid x:Name="DurationChoices" Columns="4" />
        <StackPanel x:Name="CustomDurationRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
          <TextBox x:Name="CustomMinutesBox" Width="110" AutomationProperties.Name="自定义分钟" />
          <TextBlock Text="分钟" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="DurationError" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,6,0,0" />
        <TextBlock Text="严格度" Style="{StaticResource MutedText}" Margin="0,22,0,10" />
        <UniformGrid Columns="3">
          <RadioButton x:Name="GentleChoice" GroupName="Strictness" Content="温和" Style="{StaticResource SegmentChoice}" />
          <RadioButton x:Name="StandardChoice" GroupName="Strictness" Content="标准" Style="{StaticResource SegmentChoice}" />
          <RadioButton x:Name="StrictChoice" GroupName="Strictness" Content="严格" Style="{StaticResource SegmentChoice}" Margin="0" />
        </UniformGrid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,18">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Button x:Name="GenerateButton" Content="生成规则" DockPanel.Dock="Right" Click="GenerateClick" Padding="12,6" FontWeight="Normal" />
          <TextBlock Text="本次规则" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="PolicyError" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
        <local:RuleGroupControl x:Name="AllowRules" />
        <Border Height="1" Background="{StaticResource BorderBrush}" />
        <local:RuleGroupControl x:Name="SupportiveRules" />
        <Border Height="1" Background="{StaticResource BorderBrush}" />
        <local:RuleGroupControl x:Name="BlockRules" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock Text="辅助上限" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
          <TextBox x:Name="SupportiveMinutesBox" Width="58" Margin="12,0,8,0" Padding="8,5" AutomationProperties.Name="辅助上限分钟" />
          <TextBlock Text="分钟" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
