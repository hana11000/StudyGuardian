<Window x:Class="StudyGuardian.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StudyGuardian.App"
        Title="设置" Width="620" Height="740" MinWidth="520" MinHeight="480" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,12,0">
    <DockPanel Margin="0,0,0,24">
      <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" Content="启用 AI" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
      <TextBlock Text="API 设置" FontSize="21" FontWeight="SemiBold" />
    </DockPanel>
    <DockPanel Margin="0,0,0,8">
      <TextBlock x:Name="KeyStatus" DockPanel.Dock="Right" Style="{StaticResource MutedText}" />
      <TextBlock Text="API Key" />
    </DockPanel>
    <PasswordBox x:Name="KeyBox" Height="42" Padding="10" Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="API Key" />
    <Button x:Name="ClearKeyButton" Content="清除密钥" Click="ClearKeyClick" HorizontalAlignment="Right" Background="Transparent" Padding="8" Margin="0,4,0,14" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
    <TextBlock Text="模型" Margin="0,0,0,8" />
    <TextBox x:Name="ModelBox" AutomationProperties.Name="模型" />
    <DockPanel Margin="0,12,0,0">
      <Button x:Name="TestConnectionButton" Content="测试连接" DockPanel.Dock="Right" Click="TestConnectionClick" Padding="14,8" Margin="12,0,0,0"/>
      <TextBlock x:Name="ConnectionStatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" />
    <DockPanel Margin="0,0,0,12">
      <TextBlock x:Name="BrowserPortText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" />
      <TextBlock Text="浏览器扩展" FontSize="17" FontWeight="SemiBold" />
    </DockPanel>
    <DockPanel>
      <Button Content="重置" DockPanel.Dock="Right" Click="ResetPairingClick" Padding="14,8" Margin="8,0,0,0" />
      <Button Content="复制配对码" Click="CopyPairingClick" Padding="14,8" />
    </DockPanel>
    <TextBlock x:Name="PairingStatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" />
    <TextBlock Text="AI 隐私" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
    <CheckBox x:Name="SendTitleBox" Content="发送窗口标题" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
    <CheckBox x:Name="SendUrlBox" Content="发送网址" Foreground="{StaticResource TextBrush}" />
    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" />
    <TextBlock Text="干预阈值" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,16"><TextBlock Text="提醒（秒）" Margin="0,0,0,8"/><TextBox x:Name="ReminderBox" AutomationProperties.Name="提醒秒数"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,0,16"><TextBlock Text="警告（秒）" Margin="0,0,0,8"/><TextBox x:Name="WarningBox" AutomationProperties.Name="警告秒数"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="拦截（秒）" Margin="0,0,0,8"/><TextBox x:Name="BlockBox" AutomationProperties.Name="拦截秒数"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="遮罩锁定（秒）" Margin="0,0,0,8"/><TextBox x:Name="LockBox" AutomationProperties.Name="遮罩锁定秒数"/></StackPanel>
    </Grid>
    <CheckBox x:Name="SoundBox" Content="警告提示音" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0" />
    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" />
    <TextBlock Text="全局规则" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
    <local:RuleGroupControl x:Name="GlobalAllowRules" Margin="0,0,0,16"/>
    <local:RuleGroupControl x:Name="GlobalSupportiveRules" Margin="0,0,0,16"/>
    <local:RuleGroupControl x:Name="GlobalBlockRules"/>
    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" />
    <TextBlock Text="桌面" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
    <CheckBox x:Name="StrictExitBox" Content="严格退出" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
    <CheckBox x:Name="WatchdogBox" Content="意外退出后重启" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
    <CheckBox x:Name="AutostartBox" Content="开机启动" Foreground="{StaticResource TextBrush}" />
    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1">
    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
    <Button x:Name="SaveButton" Content="保存" Click="SaveClick" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" />
    </StackPanel>
  </Grid>
</Window>
