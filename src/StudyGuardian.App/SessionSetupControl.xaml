<UserControl x:Class="StudyGuardian.App.SessionSetupControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StudyGuardian.App">
  <ContentControl Style="{DynamicResource M8.GlassCard}">
    <StackPanel>
      <TextBlock Text="今天学什么" Style="{DynamicResource M8.Title}"/>
      <TextBox x:Name="GoalBox" MinHeight="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center" Style="{DynamicResource M8.GoalInput}" Margin="0,16,0,0" AutomationProperties.Name="学习目标"/>
      <TextBlock x:Name="GoalError" Visibility="Collapsed" Foreground="{DynamicResource M8.Text}" FontSize="{DynamicResource M8.Type.Caption}" Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
        <UniformGrid x:Name="DurationChoices" Columns="4" Width="360"/>
        <TextBlock Text="分钟" Style="{DynamicResource M8.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
      <StackPanel x:Name="CustomDurationRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
        <TextBox x:Name="CustomMinutesBox" Width="110" AutomationProperties.Name="自定义分钟"/>
        <TextBlock Text="分钟" Style="{DynamicResource M8.Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="DurationError" Visibility="Collapsed" Foreground="{DynamicResource M8.Text}" FontSize="{DynamicResource M8.Type.Caption}" Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
        <RadioButton x:Name="GentleChoice" GroupName="Strictness" Content="温和" Style="{DynamicResource SegmentChoice}"/>
        <RadioButton x:Name="StandardChoice" GroupName="Strictness" Content="标准" Style="{DynamicResource SegmentChoice}"/>
        <RadioButton x:Name="StrictChoice" GroupName="Strictness" Content="严格" Style="{DynamicResource SegmentChoice}"/>
      </StackPanel>
      <DockPanel Margin="0,0,0,8">
        <Button x:Name="GenerateButton" Content="生成规则" DockPanel.Dock="Right" Click="GenerateClick" Style="{DynamicResource M8.TextButton}"/>
        <TextBlock Text="本次规则" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="PolicyError" Visibility="Collapsed" Foreground="{DynamicResource M8.Text}" TextWrapping="Wrap" FontSize="{DynamicResource M8.Type.Caption}" Margin="0,0,0,12"/>
      <local:RuleGroupControl x:Name="AllowRules"/>
      <local:RuleGroupControl x:Name="SupportiveRules"/>
      <local:RuleGroupControl x:Name="BlockRules"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
        <TextBlock Text="辅助上限" Style="{DynamicResource M8.Caption}" VerticalAlignment="Center"/>
        <TextBox x:Name="SupportiveMinutesBox" Width="64" Margin="12,0,8,0" Padding="12,6" AutomationProperties.Name="辅助上限分钟"/>
        <TextBlock Text="分钟" Style="{DynamicResource M8.Caption}" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>
  </ContentControl>
</UserControl>
