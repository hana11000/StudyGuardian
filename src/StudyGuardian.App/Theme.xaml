<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:StudyGuardian.App.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Tokens.xaml"/>
    <ResourceDictionary Source="Themes/Light.xaml"/>
    <ResourceDictionary Source="Themes/Controls.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource M8.Color.Background}"/>
  <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource M8.Color.Glass}"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource M8.Color.Subtle}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource M8.Color.Line}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource M8.Color.Text}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource M8.Color.Muted}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource M8.Color.Primary}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource M8.Color.FocusDot}"/>
  <SolidColorBrush x:Key="AmberBrush" Color="{DynamicResource M8.Color.WarnDot}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource M8.Color.BlockDot}"/>
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource M8.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource M8.Type.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
    <Setter Property="Background" Value="{DynamicResource M8.Transparent}"/>
    <Setter Property="WindowStyle" Value="None"/>
    <Setter Property="ui:FrostWindow.Material" Value="Mica"/>
    <Setter Property="ui:FrostWindow.IsDark" Value="{Binding IsDark,Source={x:Static ui:ThemeResources.Current}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
      <Border x:Name="Surface" Background="{DynamicResource M8.Background}" BorderBrush="{DynamicResource M8.GlassEdge}" BorderThickness="{DynamicResource M8.Border.Thin}" CornerRadius="{DynamicResource M8.Radius.Window}">
        <Grid ui:UiVisuals.CornerRadius="{DynamicResource M8.Radius.Window}">
          <ui:AmbientBackground x:Name="AmbientLight" State="{Binding (ui:FrostWindow.State),RelativeSource={RelativeSource TemplatedParent}}" IsDark="{Binding IsDark,Source={x:Static ui:ThemeResources.Current}}"/>
          <Grid ui:UiVisuals.AnimateIn="True">
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ui:WindowHeader/>
            <AdornerDecorator Grid.Row="1"><ContentPresenter/></AdornerDecorator>
          </Grid>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="ui:FrostWindow.HasBackdrop" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource M8.WindowTint}"/></Trigger>
        <Trigger Property="WindowState" Value="Maximized"><Setter TargetName="Surface" Property="CornerRadius" Value="0"/></Trigger>
        <Trigger Property="WindowState" Value="Minimized"><Setter TargetName="AmbientLight" Property="MotionEnabled" Value="False"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="M8.BareWindow" TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource M8.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource M8.Type.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
    <Setter Property="Background" Value="{DynamicResource M8.Transparent}"/>
    <Setter Property="WindowStyle" Value="None"/>
    <Setter Property="ui:FrostWindow.IsDark" Value="{Binding IsDark,Source={x:Static ui:ThemeResources.Current}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window"><AdornerDecorator><ContentPresenter/></AdornerDecorator></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource M8.Button}"/>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource M8.PrimaryButton}"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource M8.Input}"/>
  <Style TargetType="ComboBox" BasedOn="{StaticResource M8.ComboBox}"/>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource M8.ComboBoxItem}"/>
  <Style TargetType="CheckBox" BasedOn="{StaticResource M8.CheckBox}"><Setter Property="FontSize" Value="{DynamicResource M8.Type.Body}"/></Style>
  <Style x:Key="SegmentChoice" TargetType="RadioButton" BasedOn="{StaticResource M8.PillChoice}"><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource M8.Caption}"/>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="CornerRadius" Value="{DynamicResource M8.Radius.Card}"/>
    <Setter Property="Background" Value="{DynamicResource M8.Glass}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource M8.GlassEdge}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource M8.Border.Thin}"/>
    <Setter Property="Padding" Value="{DynamicResource M8.Space.Card}"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource M8.Text}"/>
    <Setter Property="Background" Value="{DynamicResource M8.Subtle}"/>
    <Setter Property="Padding" Value="{DynamicResource M8.Space.Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource M8.Line}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource M8.Border.Thin}" CornerRadius="{StaticResource M8.Radius.Input}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource M8.Text}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource M8.Popup}"/><Setter Property="Foreground" Value="{DynamicResource M8.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource M8.Line}"/></Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource M8.Transparent}"/><Setter Property="Foreground" Value="{DynamicResource M8.Secondary}"/><Setter Property="FontSize" Value="{DynamicResource M8.Type.Caption}"/>
    <Setter Property="Padding" Value="12,16"/><Setter Property="BorderBrush" Value="{DynamicResource M8.Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource M8.Text}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource M8.Hover}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="TableText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource M8.Transparent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource M8.Line}" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource M8.Transparent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
      </Track>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
