<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="M8.Background" Color="#0E0E12"/>
  <SolidColorBrush x:Key="M8.Glass" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="M8.GlassEdge" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="M8.Text" Color="#F4F3F0"/>
  <SolidColorBrush x:Key="M8.Muted" Color="#97979F"/>
  <SolidColorBrush x:Key="M8.Secondary" Color="#BCBCC3"/>
  <SolidColorBrush x:Key="M8.Primary" Color="#F4F3F0"/>
  <SolidColorBrush x:Key="M8.OnPrimary" Color="#1C1C1E"/>
  <SolidColorBrush x:Key="M8.Subtle" Color="#10FFFFFF"/>
  <SolidColorBrush x:Key="M8.Hover" Color="#1CFFFFFF"/>
  <SolidColorBrush x:Key="M8.Line" Color="#20FFFFFF"/>
  <SolidColorBrush x:Key="M8.Popup" Color="#24242A"/>
  <SolidColorBrush x:Key="M8.Transparent" Color="Transparent"/>
  <SolidColorBrush x:Key="M8.HoverLight" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="M8.FocusDot" Color="#A8E6CF"/>
  <SolidColorBrush x:Key="M8.WarnDot" Color="#FFD6A5"/>
  <SolidColorBrush x:Key="M8.BlockDot" Color="#FF8FA3"/>
  <SolidColorBrush x:Key="M8.IdleDot" Color="#D9D3F5"/>
  <Color x:Key="M8.Focus.A">#A8E6CF</Color><Color x:Key="M8.Focus.B">#B8D8F8</Color>
  <Color x:Key="M8.Warn.A">#FFD6A5</Color><Color x:Key="M8.Warn.B">#FFB5A7</Color>
  <Color x:Key="M8.Block.A">#FF8FA3</Color><Color x:Key="M8.Block.B">#C9B6F2</Color>
  <Color x:Key="M8.Idle.A">#D9D3F5</Color><Color x:Key="M8.Idle.B">#E5E5EA</Color>
  <sys:Double x:Key="M8.Glow.Opacity">0.35</sys:Double>
  <DropShadowEffect x:Key="M8.CardShadow" Color="#000000" Opacity="0.16" BlurRadius="40" ShadowDepth="12" Direction="270"/>
</ResourceDictionary>
