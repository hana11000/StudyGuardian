<Window x:Class="StudyGuardian.App.FloatingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:StudyGuardian.App.Controls"
 Title="Study Guardian · 悬浮窗" Width="{DynamicResource M8.Float.Width}" Height="{DynamicResource M8.Float.CollapsedHeight}"
 WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
 Style="{DynamicResource M8.BareWindow}" ui:FrostWindow.Material="Acrylic" ui:FrostWindow.ClipRadius="{DynamicResource M8.Radius.Float}" Closing="OnClosing"
 MouseEnter="EngagementChanged" MouseLeave="EngagementChanged" GotKeyboardFocus="EngagementChanged" LostKeyboardFocus="EngagementChanged">
  <Border x:Name="Surface" Focusable="True" CornerRadius="{DynamicResource M8.Radius.Float}" BorderBrush="{DynamicResource M8.GlassEdge}" BorderThickness="{DynamicResource M8.Border.Thin}" MouseLeftButtonDown="DragWindow">
    <Border.Style><Style TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource M8.Background}"/>
      <Style.Triggers><DataTrigger Binding="{Binding (ui:FrostWindow.HasBackdrop),RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="{DynamicResource M8.WindowTint}"/></DataTrigger></Style.Triggers>
    </Style></Border.Style>
    <Grid ClipToBounds="True" ui:UiVisuals.AnimateIn="True">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="8,0,14,0" ToolTip="{Binding Text,ElementName=StatusText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ui:StatusLight x:Name="Light" VerticalAlignment="Center"/>
        <TextBlock x:Name="TimeText" Grid.Column="1" FontFamily="{DynamicResource M8.Font.Number}" FontSize="{DynamicResource M8.Float.TimerSize}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Text="50:00"/>
        <TextBlock x:Name="GoalText" Grid.Column="2" Margin="12,0,8,0" FontSize="{DynamicResource M8.Type.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="FocusText" Grid.Column="3" Text="—" FontFamily="{DynamicResource M8.Font.Number}" Typography.NumeralAlignment="Tabular" FontSize="{DynamicResource M8.Type.Caption}" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel Grid.Row="1" x:Name="ExpandedPanel" Margin="12,0,12,10" Visibility="Collapsed">
        <DockPanel>
          <TextBlock x:Name="StatusText" Style="{DynamicResource M8.Caption}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBlock x:Name="AiText" Style="{DynamicResource M8.Caption}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <UniformGrid Columns="5" Margin="0,8,0,0">
          <Button x:Name="PauseButton" Content="暂停" Padding="4,5" Click="PauseClick" ToolTip="暂停" AutomationProperties.Name="暂停" Style="{DynamicResource M8.TextButton}"/>
          <Button x:Name="BreakButton" Content="休息" Padding="4,5" Click="BreakClick" AutomationProperties.Name="休息" Style="{DynamicResource M8.TextButton}"/>
          <Button Content="结束" Padding="4,5" Click="EndClick" AutomationProperties.Name="结束会话" Style="{DynamicResource M8.TextButton}"/>
          <Button Content="↗" Padding="4,5" Click="OpenMainClick" ToolTip="打开主窗口" AutomationProperties.Name="打开主窗口" Style="{DynamicResource M8.TextButton}"/>
          <Button Content="−" Padding="4,5" Click="HideClick" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘" Style="{DynamicResource M8.TextButton}"/>
        </UniformGrid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
