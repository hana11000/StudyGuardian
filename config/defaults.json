  "session": {
    "presetMinutes": [25, 50, 90],
    "defaultDurationMinutes": 50,
    "minimumDurationMinutes": 1,
    "maximumDurationMinutes": 1440,
    "defaultStrictness": "Standard",
    "decisionDwellSeconds": 5,
    "regexTimeoutMilliseconds": 100,
