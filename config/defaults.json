{
  "monitoring": {
    "awayAfterSeconds": 300,
    "idleSampleMilliseconds": 1000,
    "checkpointSeconds": 15,
    "recentEventLimit": 200,
    "maximumTitleCharacters": 2048,
    "databasePath": "data/study-guardian.db",
    "protectedProcesses": [
      "StudyGuardian.App.exe", "StudyGuardian.Watchdog.exe", "explorer.exe",
      "taskmgr.exe", "LockApp.exe", "SystemSettings.exe", "ApplicationFrameHost.exe",
      "TextInputHost.exe", "InputApp.exe", "ctfmon.exe", "ChsIME.exe", "ChsIMEHost.exe",
      "ShellExperienceHost.exe", "StartMenuExperienceHost.exe", "SearchHost.exe",
      "SearchApp.exe", "sihost.exe", "dwm.exe", "winlogon.exe", "LogonUI.exe",
      "CredentialUIBroker.exe", "consent.exe", "SecurityHealthSystray.exe"
    ]
  },
  "intervention": {
    "reminderSeconds": 10,
    "warningSeconds": 40,
    "blockSeconds": 90,
    "gentleMultiplier": 1.5,
    "strictMultiplier": 0.5,
    "focusResetSeconds": 20,
    "rollingWindowSeconds": 1800,
    "accelerationAfterSeconds": 300,
    "blockLockSeconds": 60,
    "frameThicknessPixels": 4,
    "overlayOpacity": 0.9,
