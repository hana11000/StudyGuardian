<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="M8.Font.Body">pack://application:,,,/StudyGuardian.App;component/Assets/Fonts/#MiSans, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="M8.Font.Number">Segoe UI Variable Display, Segoe UI</FontFamily>
  <sys:Double x:Key="M8.Type.Timer">48</sys:Double>
  <sys:Double x:Key="M8.Type.Title">28</sys:Double>
  <sys:Double x:Key="M8.Type.Body">15</sys:Double>
  <sys:Double x:Key="M8.Type.Caption">12</sys:Double>
  <sys:Double x:Key="M8.Type.Section">18</sys:Double>
  <CornerRadius x:Key="M8.Radius.Window">24</CornerRadius>
  <CornerRadius x:Key="M8.Radius.Card">20</CornerRadius>
  <CornerRadius x:Key="M8.Radius.Pill">999</CornerRadius>
  <CornerRadius x:Key="M8.Radius.Input">12</CornerRadius>
  <Thickness x:Key="M8.Space.Card">32</Thickness>
  <Thickness x:Key="M8.Space.CompactCard">24</Thickness>
  <Thickness x:Key="M8.Space.Button">24,12</Thickness>
  <Thickness x:Key="M8.Space.SmallButton">16,8</Thickness>
  <Thickness x:Key="M8.Space.Input">16,12</Thickness>
  <Thickness x:Key="M8.Border.Thin">1</Thickness>
  <Thickness x:Key="M8.Border.None">0</Thickness>
  <sys:Double x:Key="M8.Noise.Opacity">0.03</sys:Double>
  <sys:Double x:Key="M8.Dot.Blur">12</sys:Double>
  <sys:Double x:Key="M8.Dot.Dim">0.3</sys:Double>
  <sys:Double x:Key="M8.Dot.Bright">0.7</sys:Double>
  <sys:Double x:Key="M8.Motion.EnterScale">0.96</sys:Double>
  <sys:Double x:Key="M8.Disabled.Opacity">0.38</sys:Double>
  <sys:Double x:Key="M8.Glow.Blur">140</sys:Double>
  <sys:Double x:Key="M8.Glow.CacheScale">0.5</sys:Double>
  <sys:Double x:Key="M8.Glow.LightOpacity">0.72</sys:Double>
  <sys:Double x:Key="M8.Glow.DarkOpacity">0.35</sys:Double>
  <sys:Double x:Key="M8.Glow.DriftX">80</sys:Double>
  <sys:Double x:Key="M8.Glow.DriftY">56</sys:Double>
  <sys:Int32 x:Key="M8.Motion.FrameRate">30</sys:Int32>
  <sys:Double x:Key="M8.Motion.HoverScale">1.02</sys:Double>
  <Duration x:Key="M8.Motion.Hover">0:0:0.15</Duration>
  <Duration x:Key="M8.Motion.Appear">0:0:0.28</Duration>
  <Duration x:Key="M8.Motion.State">0:0:1.2</Duration>
  <Duration x:Key="M8.Motion.DriftA">0:0:24</Duration>
  <Duration x:Key="M8.Motion.DriftB">0:0:28</Duration>
  <Duration x:Key="M8.Motion.DriftC">0:0:22</Duration>
  <!-- AutoReverse completes the four-second breathing cycle. -->
  <Duration x:Key="M8.Motion.BreathHalfCycle">0:0:2</Duration>
  <sys:Double x:Key="M8.Float.Width">260</sys:Double>
  <CornerRadius x:Key="M8.Radius.Float">22</CornerRadius>
  <sys:Double x:Key="M8.Float.CollapsedHeight">44</sys:Double>
  <sys:Double x:Key="M8.Float.ExpandedHeight">112</sys:Double>
  <sys:Double x:Key="M8.Float.TimerSize">22</sys:Double>
  <sys:Double x:Key="M8.Float.IdleOpacity">0.5</sys:Double>
  <Duration x:Key="M8.Float.IdleDelay">0:2:0</Duration>
  <Duration x:Key="M8.Float.IdleTick">0:0:1</Duration>
  <Duration x:Key="M8.Motion.Expand">0:0:0.3</Duration>
  <sys:Double x:Key="M8.Warning.EdgeWidth">80</sys:Double>
  <sys:Double x:Key="M8.Warning.EdgeOpacity">0.65</sys:Double>
  <sys:Double x:Key="M8.Notice.Width">340</sys:Double>
  <sys:Double x:Key="M8.Notice.Gap">8</sys:Double>
  <sys:Double x:Key="M8.Type.LockTimer">72</sys:Double>
  <sys:Double x:Key="M8.Ring.Thickness">12</sys:Double>
  <CornerRadius x:Key="M8.Radius.Timeline">6</CornerRadius>
  <LinearGradientBrush x:Key="M8.FocusGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{DynamicResource M8.Focus.A}" Offset="0"/>
    <GradientStop Color="{DynamicResource M8.Focus.B}" Offset="1"/>
  </LinearGradientBrush>
  <CubicEase x:Key="M8.Ease.Soft" EasingMode="EaseInOut"/>
  <BackEase x:Key="M8.Ease.Enter" Amplitude="0.3" EasingMode="EaseOut"/>
  <ImageBrush x:Key="M8.Noise" ImageSource="/StudyGuardian.App;component/Assets/Textures/noise-128.png"
              TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="None"/>
</ResourceDictionary>
