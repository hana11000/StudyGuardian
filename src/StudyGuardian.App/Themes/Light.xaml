<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="M8.Background" Color="#F4F3F0"/>
  <SolidColorBrush x:Key="M8.Glass" Color="#8CFFFFFF"/>
  <SolidColorBrush x:Key="M8.GlassEdge" Color="#CCFFFFFF"/>
  <SolidColorBrush x:Key="M8.Text" Color="#1C1C1E"/>
  <SolidColorBrush x:Key="M8.Muted" Color="#8E8E93"/>
  <SolidColorBrush x:Key="M8.Secondary" Color="#636369"/>
  <SolidColorBrush x:Key="M8.Primary" Color="#1C1C1E"/>
  <SolidColorBrush x:Key="M8.OnPrimary" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="M8.Subtle" Color="#0C1C1C1E"/>
  <SolidColorBrush x:Key="M8.Hover" Color="#141C1C1E"/>
  <SolidColorBrush x:Key="M8.Line" Color="#181C1C1E"/>
  <SolidColorBrush x:Key="M8.Popup" Color="#F8F8F6"/>
  <SolidColorBrush x:Key="M8.Transparent" Color="Transparent"/>
  <SolidColorBrush x:Key="M8.HoverLight" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="M8.FocusDot" Color="#A8E6CF"/>
  <SolidColorBrush x:Key="M8.WarnDot" Color="#FFD6A5"/>
  <SolidColorBrush x:Key="M8.BlockDot" Color="#FF8FA3"/>
  <SolidColorBrush x:Key="M8.IdleDot" Color="#D9D3F5"/>
  <Color x:Key="M8.Focus.A">#A8E6CF</Color><Color x:Key="M8.Focus.B">#B8D8F8</Color>
  <Color x:Key="M8.Warn.A">#FFD6A5</Color><Color x:Key="M8.Warn.B">#FFB5A7</Color>
  <Color x:Key="M8.Block.A">#FF8FA3</Color><Color x:Key="M8.Block.B">#C9B6F2</Color>
  <Color x:Key="M8.Idle.A">#D9D3F5</Color><Color x:Key="M8.Idle.B">#E5E5EA</Color>
  <sys:Double x:Key="M8.Glow.Opacity">0.72</sys:Double>
  <DropShadowEffect x:Key="M8.CardShadow" Color="#1A1A2E" Opacity="0.06" BlurRadius="40" ShadowDepth="12" Direction="270"/>
</ResourceDictionary>
